{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "slot-forge/rules.schema.json",
  "title": "slot-forge rules.json",
  "description": "Slot 遊戲規則描述(T2)。由 slot-rules-ingest 從 demo 網站產出,供狀態機生成(T2)、滾輪模組(T4)、假後端(T9)、Info 頁(T13)共用。",
  "type": "object",
  "required": ["schemaVersion", "game", "board", "evaluation", "symbols", "features", "flow"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^0\\.\\d+\\.\\d+$" },
    "game": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^\\d{4}s$", "description": "專案代號,例:1070s" },
        "name": { "type": "object", "description": "語系 → 名稱", "additionalProperties": { "type": "string" } },
        "source": { "type": "string", "description": "規則來源(demo 網址或檔名)" },
        "baseArchitecture": { "type": "string", "description": "架構範本,例:1070s(OMGSlotKit)" }
      }
    },
    "board": {
      "type": "object",
      "required": ["reels", "rowsPerReel"],
      "additionalProperties": false,
      "properties": {
        "reels": { "type": "integer", "minimum": 1, "maximum": 12 },
        "rowsPerReel": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 }, "description": "每軸可見列數;不等高盤面如 [4,5,5,5,4]" },
        "alignment": { "enum": ["center", "top", "bottom"], "default": "center", "description": "不等高軸的垂直對齊" },
        "symbolSize": { "$ref": "#/definitions/size", "description": "符號格尺寸(最終值,非佔位)" },
        "reelFrameSize": { "$ref": "#/definitions/size", "description": "滾輪框尺寸(最終值)" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["lines", "ways", "cluster", "scatterPays"] },
        "direction": { "enum": ["leftToRight", "rightToLeft", "both"], "default": "leftToRight" },
        "minMatch": { "type": "integer", "minimum": 1, "default": 3 },
        "waysCount": { "type": "integer", "minimum": 1, "description": "ways 時 = Π rowsPerReel(validator 會檢查)" },
        "lines": { "type": "array", "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "description": "lines 時:每條線在各軸的列索引" },
        "clusterMin": { "type": "integer", "minimum": 2 },
        "betMultiplier": { "type": "number", "exclusiveMinimum": 0, "description": "總押注 = 單位押注 × betMultiplier" }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "kind": { "enum": ["high", "low", "wild", "scatter", "bonus", "collect", "blank"] },
          "pays": { "type": "object", "description": "連線數 → 倍數(相對單位押注);TBD 時可省略", "patternProperties": { "^\\d+$": { "type": "number", "minimum": 0 } }, "additionalProperties": false },
          "substitutes": { "type": "array", "items": { "type": "string" }, "description": "wild 可替代的 symbol id;省略 = 全部非特殊符號" },
          "reels": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "允許出現的軸(0-based);省略 = 全部" },
          "size": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2, "description": "大型符號 [寬軸數, 高列數]" },
          "tbd": { "type": "boolean", "description": "true = 來源資料未提供,為佔位" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "trigger"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["cascade", "multiplierLadder", "freeGame", "respin", "collect", "buyFeature", "jackpot", "expandingWild", "stickyWild"] },
          "trigger": { "$ref": "#/definitions/trigger" },
          "params": { "type": "object", "description": "依 type 而定,見 knowledge/T2/rules-schema.md 的 params 對照表" },
          "phase": { "type": "array", "items": { "enum": ["base", "free", "respin"] }, "description": "此 feature 生效的遊戲階段" }
        }
      }
    },
    "flow": {
      "type": "object",
      "required": ["states"],
      "additionalProperties": false,
      "properties": {
        "initial": { "type": "string", "default": "Idle" },
        "states": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "on"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "on": { "type": "string", "description": "事件名或條件,例:spinPressed / hasWin / feature:respin" },
              "guard": { "type": "string" }
            }
          }
        }
      }
    },
    "bet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "default": { "type": "number" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "maxWinX": { "type": "number", "exclusiveMinimum": 0, "description": "最大贏分倍數上限(T8)" } }
    },
    "locales": { "type": "array", "items": { "type": "string" }, "default": ["en", "tw"] },
    "openQuestions": { "type": "array", "items": { "type": "string" }, "description": "從來源無法確定、需人工確認的事項" }
  },
  "definitions": {
    "size": { "type": "object", "required": ["w", "h"], "additionalProperties": false, "properties": { "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } } },
    "trigger": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["always", "onWin", "symbolCount", "collectThreshold", "buy", "random", "onFeatureEnd"] },
        "symbol": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["board", "spin", "session"], "description": "計數範圍:單盤 / 單局(含 cascade)/ 跨局累積" }
      }
    }
  }
}
